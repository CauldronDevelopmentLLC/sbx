#!/bin/bash
# Installs or updates Floorp in $SBX_APPS/floorp
app=floorp
. "$SBX_LIB/templates/app.sh"

asset=floorp-linux-$(arch x86_64 aarch64).tar.xz
info=$(curl -fsS --proto =https \
  'https://api.github.com/repos/Floorp-Projects/Floorp/releases/latest' |
  python3 -c '
import json, sys
release = json.load(sys.stdin)
asset = next(a for a in release["assets"] if a["name"] == sys.argv[1])
print(release["tag_name"].lstrip("v"), asset["browser_download_url"],
      asset["digest"])' "$asset")
read -r version url digest <<< "$info"

check "$version"

# Floorp publishes no checksum for the archive, GitHub's digest guards against
# corruption
fetch "$url"
log "Verifying"
echo "${digest#sha256:}  $tmp/$asset" | sha256sum -c --quiet

log "Unpacking"
mkdir "$tmp/unpacked"
tar -xJf "$tmp/$asset" -C "$tmp/unpacked"
root=$(root "$tmp/unpacked")

# The install is read-only, it is updated with "sbx update"
mkdir -p "$root/distribution"
echo '{"policies": {"DisableAppUpdate": true}}' \
  > "$root/distribution/policies.json"

activate "$version" "$root"
