#!/bin/bash
# Installs or updates a Brave variant in $SBX_APPS/<variant>, e.g.
# brave-browser, brave-origin or brave-origin-nightly
app=${1:-brave-browser}
. "$SBX_LIB/templates/app.sh"

# Brave's keys for GitHub checksums, from brave.com/signing-keys.  Release
# builds are pre-releases, signed with the pre-release key, until promoted.
case $app in
  *-nightly|*-beta) key=checksums-pre-release.asc pre=1 ;;
  *) key=checksums-release.asc pre= ;;
esac

info=$(curl -fsS --proto =https \
  'https://api.github.com/repos/brave/brave-browser/releases?per_page=100' |
  python3 -c '
import json, re, sys
name = re.compile(re.escape(sys.argv[1]) + r"-([0-9.]+)-linux-" + sys.argv[2] +
                  r"\.zip")
for release in json.load(sys.stdin):
  if release["prerelease"] and not sys.argv[3]: continue
  for asset in release["assets"]:
    if match := name.fullmatch(asset["name"]):
      sys.exit(print(match[1], asset["browser_download_url"]))
sys.exit("No release of " + sys.argv[1] + " found")' \
  "$app" "$(arch amd64 arm64)" "$pre")
read -r version url <<< "$info"

check "$version"

zip=${url##*/}
fetch "$url"
fetch "$url.sha256"
fetch "$url.sha256.asc"

log "Verifying"
gpg --homedir "$tmp" -q --dearmor < "${0%/*}/$key" > "$tmp/key.gpg"
gpgv --homedir "$tmp" -q --keyring "$tmp/key.gpg" "$tmp/$zip.sha256.asc" \
  "$tmp/$zip.sha256"
(cd "$tmp" && sha256sum -c --quiet "$zip.sha256")

log "Unpacking"
unzip -q "$tmp/$zip" -d "$tmp/unpacked"
activate "$version" "$(root "$tmp/unpacked")"
