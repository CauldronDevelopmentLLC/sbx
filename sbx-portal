                      choices = PORTALS, help = 'enable a portal')
  parser.add_argument('--forward', action = 'append', default = [],
                      help = 'forward a D-Bus name to the host')
  parser.add_argument('--verbose', action = 'store_true')
  args = parser.parse_args()

  Service(args.dir, args.app_id, args.portal, args.forward,
