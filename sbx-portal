#!/usr/bin/env python3
'''
A private D-Bus session bus and XDG Desktop Portal for an sbx sandbox.

Sandboxes get their own bus rather than filtered access to the host's.  sbx
implements the FileChooser and OpenURI portals itself, using the host's portal
backend for dialogs and the host's document portal to export chosen files.
Other portals and services are forwarded to the host by name.  Because every
client on the private bus belongs to the sandbox, no flatpak style app
identification is needed.

One service, and bus, is shared by all runs of the same sandbox.  Each run
holds a shared lock for its lifetime.  The service exits once it can take the
lock exclusively.  sbx starts it, see SBX.setup_portal().
'''

import os
import stat
import fcntl
import ctypes
import signal
import argparse
import subprocess
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib


DESKTOP      = 'org.freedesktop.portal.Desktop'
DOCUMENTS    = 'org.freedesktop.portal.Documents'
REQUEST      = 'org.freedesktop.portal.Request'
FILE_CHOOSER = 'org.freedesktop.portal.FileChooser'
OPEN_URI     = 'org.freedesktop.portal.OpenURI'
PRINT        = 'org.freedesktop.portal.Print'
PROPERTIES   = 'org.freedesktop.DBus.Properties'
IMPL         = 'org.freedesktop.impl.portal'
DESKTOP_PATH = '/org/freedesktop/portal/desktop'
DOCS_PATH    = '/org/freedesktop/portal/documents'
NO_FLAGS     = Gio.DBusCallFlags.NONE

# Portals forwarded to the host's portal
PASSTHROUGH = {
  'settings':        'org.freedesktop.portal.Settings',
  'network-monitor': 'org.freedesktop.portal.NetworkMonitor',
  'proxy-resolver':  'org.freedesktop.portal.ProxyResolver',
}
LOCAL       = ('file-chooser', 'open-uri', 'print') # Need the backend
PORTALS     = LOCAL + tuple(PASSTHROUGH)
URI_SCHEMES = ('http', 'https', 'mailto')
VERSIONS    = {FILE_CHOOSER: 3, OPEN_URI: 4, DOCUMENTS: 4, PRINT: 2}

# Document portal AddFull flags
REUSE_EXISTING   = 1
AS_NEEDED_BY_APP = 4
EXPORT_DIRECTORY = 8

# FileChooser options passed on to the backend
CHOOSER_OPTIONS = {
  'accept_label': 's', 'modal': 'b', 'multiple': 'b', 'directory': 'b',
  'filters': 'a(sa(us))', 'current_filter': '(sa(us))',
  'choices': 'a(ssa(ss)s)', 'current_name': 's'}

# Print options passed on to the backend
PRINT_OPTIONS = {'modal': 'b', 'token': 'u', 'accept_label': 's'}

# No <servicedir>, otherwise the sandbox could start host services
BUS_CONFIG = '''\
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:path=%s</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
'''

INTROSPECTION = Gio.DBusNodeInfo.new_for_xml('''
<node>
  <interface name="org.freedesktop.portal.FileChooser">
    <method name="OpenFile">
      <arg type="s" direction="in"/><arg type="s" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <method name="SaveFile">
      <arg type="s" direction="in"/><arg type="s" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <method name="SaveFiles">
      <arg type="s" direction="in"/><arg type="s" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <property name="version" type="u" access="read"/>
  </interface>
  <interface name="org.freedesktop.portal.OpenURI">
    <method name="OpenURI">
      <arg type="s" direction="in"/><arg type="s" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <method name="OpenFile">
      <arg type="s" direction="in"/><arg type="h" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <method name="OpenDirectory">
      <arg type="s" direction="in"/><arg type="h" direction="in"/>
      <arg type="a{sv}" direction="in"/><arg type="o" direction="out"/>
    </method>
    <method name="SchemeSupported">
      <arg type="s" direction="in"/><arg type="a{sv}" direction="in"/>
