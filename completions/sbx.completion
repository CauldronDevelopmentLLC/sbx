_sbx_completions() {
  local cur prev CMDS SBCMDS LIB
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  CMDS="create run update rename list ps enter list-rules delete show edit"
  CMDS+=" template help"
  SBCMDS="run update rename enter delete show edit template"
  LIB="$(dirname "$(readlink -f "$(command -v sbx)")")"
  [ -d "$LIB/../lib/sbx" ] && LIB+=/../lib/sbx # Else a checkout, as sbx does

  case "$prev" in
    -t|--template|-c|--config) # Template names, <name>.yml or <name>/, or paths
      local t tpls="" user="${XDG_CONFIG_HOME:-$HOME/.config}/sbx/templates"
      for t in "$user"/{*.yml,*/config.yml} \
               "$LIB"/templates/{*.yml,*/config.yml}; do
        [ -e "$t" ] || continue
        t=${t%/config.yml}; t=${t%.yml}; tpls+=" ${t##*/}"
      done
      COMPREPLY=( $(compgen -W "$tpls" -- ${cur}) )
      [[ $cur == */* ]] && COMPREPLY+=( $(compgen -f -- ${cur}) )
      return
      ;;
    -r|--rule)
      COMPREPLY=( $(compgen -W "$(sbx list-rules 2>/dev/null | cut -d' ' -f1)" \
                    -- ${cur}) )
      return
      ;;
  esac

  if [[ " ${SBCMDS} " =~ .*\ ${prev}\ .* ]]; then
    COMPREPLY=( $(compgen -W "$(sbx list)" -- ${cur}) )

  elif [ $COMP_CWORD -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$CMDS" -- ${cur}) )
  fi
}

complete -F _sbx_completions sbx
