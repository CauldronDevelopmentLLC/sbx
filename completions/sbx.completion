_sbx_completions() {
  local cur prev CMDS SBCMDS LIB
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  CMDS="create run update rename list ps enter list-rules delete show edit"
  CMDS+=" template help"
  SBCMDS="run update rename enter delete show edit template"
  LIB="$(dirname "$(readlink -f "$(command -v sbx)")")/../lib/sbx"

  case "$prev" in
    -t|--template)
      local dir tpls=""
      for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/sbx/templates" \
                 "$LIB/templates"; do
        [ -d "$dir" ] && tpls+=" $(cd "$dir" && ls -d */ 2>/dev/null)"
      done
      COMPREPLY=( $(compgen -W "${tpls//\//}" -- ${cur}) )
      return
      ;;
    -c|--config)
      COMPREPLY=( $(compgen -f -- ${cur}) )
      return
      ;;
  esac

  if [[ " ${SBCMDS} " =~ .*\ ${prev}\ .* ]]; then
    COMPREPLY=( $(compgen -W "$(sbx list)" -- ${cur}) )

  elif [ $COMP_CWORD -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$CMDS" -- ${cur}) )
  fi
}

complete -F _sbx_completions sbx
