check('CreateGC foreign tile stripped', run(c, r) == req(55, 0, struct.pack('<III', OWN2, OWN, 0)))
check('CopyArea from root dropped', run(c, req(62, 0, struct.pack('<IIIhhhhHH', ROOT, OWN, OWN2, 0, 0, 0, 0, 1, 1))) == NOOP)

