'''Offline tests of sbx-x11's filtering, on hand-built requests and replies.'''

import os, sys, struct, importlib.machinery, importlib.util
from collections import deque

loader = importlib.machinery.SourceFileLoader('sbx_x11', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'sbx-x11'))
spec = importlib.util.spec_from_loader('sbx_x11', loader)
m = importlib.util.module_from_spec(spec); loader.exec_module(m)

OWN, OWN2, ROOT, OTHER = 0x200001, 0x200002, 0x500, 0x400010
CLIPBOARD, DND_SEL, DND_POS, PROTOCOLS, TAKE_FOCUS, WM_S0, XEMBED = 500, 600, 601, 700, 701, 702, 703
RES_MAN, DESK_NAMES, ACTIVE, CLIENTS = 801, 802, 803, 804
NAMES = {CLIPBOARD: 'CLIPBOARD', 1: 'PRIMARY', DND_SEL: 'XdndSelection', DND_POS: 'XdndPosition', PROTOCOLS: 'WM_PROTOCOLS',
         TAKE_FOCUS: 'WM_TAKE_FOCUS', WM_S0: 'WM_S0', XEMBED: '_XEMBED',
         RES_MAN: 'RESOURCE_MANAGER', DESK_NAMES: '_NET_DESKTOP_NAMES', ACTIVE: '_NET_ACTIVE_WINDOW', CLIENTS: '_NET_CLIENT_LIST'}

class Server:
  '''The trusted connection's answers, set by the tests.'''
  ops = {130: 'XInputExtension', 131: 'RENDER', 132: 'GLX', 133: 'XTEST', 134: 'XKEYBOARD', 135: 'MIT-SHM', 136: 'Composite',
         137: 'XFree86-VidModeExtension', 138: 'RANDR', 139: 'XVideo'}
  events = {'XInputExtension': 70, 'XKEYBOARD': 85}
  roots, clipboard, dnd_selection, dnd_messages = {ROOT}, CLIPBOARD, DND_SEL, {DND_POS}
  wm_protocols, take_focus = PROTOCOLS, TAKE_FOCUS
  paste_buttons = {1: (CLIPBOARD,), 2: (m.PRIMARY,), 3: (CLIPBOARD,)}
  def __init__(self): self.focus_window, self.owners = OWN, {}
  def focus(self): return self.focus_window
  def owner(self, selection): return self.owners.get(selection, 0)
  def access(self, window, atom):
    name = self.name(atom)
    if window in self.roots: return 'windows' if name in m.ROOT_WINDOW_LISTS else 'read' if name in m.ROOT_PROPERTIES else None
    return 'read' if atom == 39 else None # As if public
  def name(self, atom): return NAMES.get(atom, str(atom))
  def pasted(self, keycode, mods): return (CLIPBOARD,) if keycode == 55 and mods & m.CONTROL else ()

class Feed:
  '''Feeds chunks like the proxy, carrying leftovers between reads.'''
  def __init__(self, process): self.process, self.left = process, b''
  def __call__(self, chunk):
    buf = memoryview(bytearray(chunk))
    data = self.left + buf if self.left else buf
    out, used = self.process(data)
    self.left = bytes(data[used:])
    return b''.join(out)

def client(p = None, base = 0x200000):
  if not p:
    p = m.Proxy.__new__(m.Proxy) # No sockets
    p.server, p.clients, p.paste, p.writes, p.allowed = Server(), set(), {}, {}, set()
    p.input_until = p.focus_until = p.drag_until = 0
  c = m.Client.__new__(m.Client)
  c.proxy, c.server, c.verbose, c.seq, c.pending, c.c_rem, c.s_rem = p, p.server, False, 0, deque(), 0, 0
  c.o, c.base, c.mask = '<', base, 0x1fffff
  c.build_checks()
  p.clients.add(c)
  c.cf, c.sf = Feed(c.from_client), Feed(c.from_server)
  return c

NOOP, GIF = struct.pack('<BxH', 127, 1), struct.pack('<BxH', 43, 1)
fails = 0
def check(name, ok, detail = ''):
  global fails
  fails += not ok
  print(f'{"PASS" if ok else "FAIL"} {name} {detail}')

def req(op, minor, body):
  body = bytes(body); body += b'\0' * (-len(body) % 4)
  return struct.pack('<BBH', op, minor, 1 + len(body) // 4) + body

def run(c, data): return c.cf(data)

# Core
c = client()
r = req(2, 0, struct.pack('<III', ROOT, 1 << 11, 1 | 2 | 1 << 22))
check('CWA root strips key events', run(c, r) == req(2, 0, struct.pack('<III', ROOT, 1 << 11, 1 << 22)))
