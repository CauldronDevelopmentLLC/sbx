# Focus, selections and properties
def key(code, keycode, state, window = OWN): return struct.pack('<BBHIIIIhhhhHBx', code, keycode, 0, 0, ROOT, window, 0, 0, 0, 0, 0, state, 1)
def xi2(evtype, detail, mods = 0, window = OWN):
  return struct.pack('<BBHIHHIIIII16xHHHHI4I4x', 35, 130, 0, 12, evtype, 3, 0, detail, ROOT, window, 0, 0, 0, 3, 0, 0, 0, 0, 0, mods)
def convert(requestor, selection, stamp = 7): return req(24, 0, struct.pack('<5I', requestor, selection, 31, 99, stamp))
def refused(requestor, selection, stamp = 7):
  return struct.pack('<BxHII', 25, 11, requestor, 0) + struct.pack('<B3x5I8x', 31, stamp, requestor, selection, 31, 0)

