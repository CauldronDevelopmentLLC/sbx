#!/usr/bin/env python3
'''
X11 proxy for an sbx sandbox.

Sandboxed clients connect here rather than to the X server.  Their requests
are forwarded with the host's credentials, so they get a fully featured
connection, e.g. GLX, DRI3, MIT-SHM and RENDER, but requests which would let
them observe or inject other clients' input, or read other clients' windows,
are dropped or answered with an error.

A resource is the sandbox's own if its ID is in the range the server gave one
of the sandbox's clients at connection setup.  Anything else, e.g. the root
window or another application's window, is foreign.

Denied requests are replaced, keeping sequence numbers in step, by
NoOperation or, if the client expects a reply, by GetInputFocus whose reply is
then replaced by a fake reply or an error.  Extensions not in ALLOWED are
hidden.  Opcodes are learned at startup, so clients cannot guess around them.

Selections, e.g. the clipboard, owned outside the sandbox are readable only
briefly after the user pastes into the sandbox or drags onto it, and only by
the selection's owner at the first read.  Key events are dropped unless a
sandbox window has the input focus, so an active grab cannot capture keys
typed elsewhere.  Other clients' window properties are readable only if
public, e.g. WM_STATE but not titles.  A trusted connection answers the
queries these checks need.

One event loop relays all connections.  Messages are parsed by header only and
unchanged data is passed on without copying.  Tests: tests/sbx-x11.
'''

import os
import time
import struct
import socket
import argparse
import selectors
from array import array
from collections import deque
from selectors import EVENT_READ, EVENT_WRITE


# Extensions sandboxed clients may use, others are hidden and blocked
ALLOWED = {
