RECV_SIZE       = 1 << 20
READS           = 16 # Per readiness event
FD_SPACE        = socket.CMSG_SPACE(255 * array('i').itemsize)
ALREADY_GRABBED = 1
POINTER_ROOT    = 1 # Input focus follows the pointer
