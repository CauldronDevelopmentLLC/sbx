  '--rule', '-r', action = 'append', help = 'rule or rules to apply, in ' +
  'addition to the template\'s')
create_parser.add_argument('name', help = 'name of the sandbox')
create_parser.add_argument(
  'command', nargs = '*', help = 'the command to run and optional arguments, ' +
  'defaults are used if not specified')

run_parser = subs.add_parser('run', help = 'run an existing sandbox')
run_parser.add_argument('name', help = 'name of the sandbox')
run_parser.add_argument(
  '--command', '-C', help = 'override the sandbox command')
run_parser.add_argument('args', nargs = '*',
  help = 'optional additional arguments to pass to the sandbox command')

subs.add_parser('list', help = 'list existing sandboxes')
subs.add_parser('ps',   help = 'list running sandboxes')

lr_parser = subs.add_parser('list-rules', help = 'list available rules')
lr_parser.add_argument(
  '--config', '-c', help = 'template or path to list the rules of, ' +
  'default "global"')

del_parser = subs.add_parser('delete', help = 'delete an existing sandbox')
del_parser.add_argument('name', help = 'name of the sandbox')
del_parser.add_argument(
  '--force', '-f', action = 'store_true', help = 'delete without asking')

show_parser = subs.add_parser('show', help = 'print sandbox config and exit')
show_parser.add_argument('name', help = 'name of the sandbox')

edit_parser = subs.add_parser('edit', help = 'edit sandbox config')
edit_parser.add_argument('name', help = 'name of the sandbox')

tpl_parser = subs.add_parser(
  'template', help = 'create a template from an existing sandbox')
tpl_parser.add_argument('name', help = 'name of the source sandbox')
tpl_parser.add_argument('template_name', help = 'name of the new template')
tpl_parser.add_argument(
  '--force', '-f', action = 'store_true',
  help = 'overwrite the template if it already exists')

upd_parser = subs.add_parser(
  'update', help = 'update a sandbox with its update-hook, e.g. its program')
upd_parser.add_argument('name', help = 'name of the sandbox')

ren_parser = subs.add_parser('rename', help = 'rename an existing sandbox')
ren_parser.add_argument('name', help = 'current name of the sandbox')
ren_parser.add_argument('new_name', help = 'new name of the sandbox')

ent_parser = subs.add_parser('enter', help = 'enter a running sandbox')
ent_parser.add_argument('target', help = 'name of the sandbox, or a PID ' +
                        'from "sbx ps" if several instances are running')
ent_parser.add_argument('command', nargs = '*', help = 'command and ' +
                        'arguments to run instead of a login shell, after "--"')

subs.add_parser('help', help = 'show this help message and exit')

args = parser.parse_args()

if args.cmd is None or args.cmd == 'help':
  parser.print_help()
  sys.exit(1)

try:
  SBX(args).exec()

except SBError as e:
  print(f'ERROR: {str(e)}.', file = sys.stderr)
  sys.exit(1)
