  help = 'overwrite the template if it already exists')

upd_parser = subs.add_parser(
  'update', help = 'update a sandbox with its update-hook, e.g. its program')
upd_parser.add_argument('name', help = 'name of the sandbox')

ren_parser = subs.add_parser('rename', help = 'rename an existing sandbox')
ren_parser.add_argument('name', help = 'current name of the sandbox')
ren_parser.add_argument('new_name', help = 'new name of the sandbox')

ent_parser = subs.add_parser('enter', help = 'enter a running sandbox')
ent_parser.add_argument('target', help = 'name of the sandbox, or a PID ' +
                        'from "sbx ps" if several instances are running')
ent_parser.add_argument('command', nargs = '*', help = 'command and ' +
                        'arguments to run instead of a login shell, after "--"')

subs.add_parser('help', help = 'show this help message and exit')

args = parser.parse_args()

if args.cmd is None or args.cmd == 'help':
  parser.print_help()
  sys.exit(1)

try:
  SBX(args).exec()

except SBError as e:
  print(f'ERROR: {str(e)}.', file = sys.stderr)
  sys.exit(1)
