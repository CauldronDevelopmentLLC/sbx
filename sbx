class Dumper(yaml.Dumper):
  def increase_indent(self, flow = False, indentless = False):
    return super().increase_indent(flow, False)


def fork_and_write(data):
  pr, pw = os.pipe2(0)

  if os.fork() == 0:
    os.close(pr)
    os.write(pw, data if isinstance(data, bytes) else data.encode())
    sys.exit(0)

  os.close(pw)

  return pr


def copytree(src, dst):
  src = os.path.realpath(src)

  for root, dirs, files in os.walk(src):
    target = os.path.join(dst, root[len(src):])

    for dir in dirs:
      tgtPath = os.path.join(target, dir)
      if not os.path.exists(tgtPath):
        os.makedirs(tgtPath)
        shutil.copystat(os.path.join(root, dir), tgtPath)

    for file in files:
      tgtPath = os.path.join(target, file)
      if not os.path.exists(tgtPath):
        #print('{} -> {}'.format(os.path.join(root, file), tgtPath))
        shutil.copy2(os.path.join(root, file), tgtPath)


def display_in_use(num):
  with socket.socket(socket.AF_UNIX) as s:
    try: s.connect(f'\0/tmp/.X11-unix/X{num}')
    except OSError: return os.path.exists(f'/tmp/.X11-unix/X{num}')
  return True


def parse_allow_net(s):
  '''Parse "<cidr>", "<addr>:<port>" or "[<addr>]:<port>".'''
  if s.startswith('['):
    addr, _, port = s[1:].partition(']')
    port = port.removeprefix(':')
  elif s.count(':') == 1: addr, port = s.split(':')
  else: addr, port = s, ''

  return ipaddress.ip_network(addr), int(port) if port else None


def find_lib():
  '''sbx's system files, in <prefix>/lib/sbx or, in a checkout, next to sbx.'''
  bin = os.path.dirname(os.path.realpath(__file__))
  lib = os.path.normpath(f'{bin}/../lib/sbx')
  return lib if os.path.isdir(lib) else bin


SBX_LIB = find_lib()


def get_pid_ns(pid = os.getpid()):
  link = os.readlink(f'/proc/{pid}/ns/pid')
  return link.split('[')[-1].rstrip(']')


class SBX:
  def __init__(self, args):
    self.args             = args
    self.cmd_args         = []
    self.portals          = set()
    self.dbus_forwards    = set()
    self.loaded           = set()
    self.applied          = []
    self.rules            = {} # Name or (path, _name) -> (path, actions)
    self.origin           = None # Config of the rule being applied
    self.runtime_dir      = os.environ['XDG_RUNTIME_DIR']
    self.tempdirs         = set()
    self.die_with_parent  = False
    self.allowed_syscalls = set()
    self.x11              = None
    self.x11_auth_id      = None
    self.portal_lock      = None
    self.net              = None
    self.allow_net        = set()
    self.host_ports       = set()
    self.proxies          = set()


  def log(self, s):
    if self.args.verbose: print(s)


  def expand_path(self, path): return os.path.expanduser(self.expand(path))
  def expand(self, s): return os.path.expandvars(str(s))


  def require_config(self):
    config = self.expand_path(SANDBOX_CONFIG)

    if not os.path.exists(config):
      raise SBError(f'Sandbox "{self.args.name}" does not exists')

    return config


  def load_config(self, path):
    path = self.expand_path(path)

    # Only load config once
    npath = os.path.normpath(path)
    if npath in self.loaded: return
    self.loaded.add(npath)

    if not os.path.exists(path):
      raise SBError(f'Config "{path}" not found')

    self.log(f'Loading config "{path}"')

    with open(path) as f: config = yaml.full_load(f)
    rules = config.get('rules', {})

    if not isinstance(rules, dict):
      raise SBError('"rules" is not a dictionary')

    # Imports
    imports = config.get('imports', [])
    if not isinstance(imports, list):
      raise SBError('"imports" is not a list')

    for imp in imports:
      imp = self.expand_path(imp)
      if not os.path.isabs(imp):
        imp = os.path.relpath(imp, os.path.dirname(path))
      self.load_config(imp)

    # Load rules (overwriting previous), those starting with _ are private
    for name, rule in rules.items():
      self.rules[(npath, name) if name.startswith('_') else name] = \
        (npath, rule)

    # Save config (overwriting previous)
    self.config, self.config_path = config, npath


  def load_local(self):
    '''Load local.yml, if any, and return its path and the rules it uses.'''
    if not os.path.exists(self.expand_path(LOCAL_CONFIG)): return None, []
    self.load_config(LOCAL_CONFIG)
    return self.config_path, self.config.get('use', [])


  def run_hook(self, name, extra_env = None):
    hook = self.config.get(name)
    if not hook: return 0

    config_dir = os.path.dirname(self.expand_path(SANDBOX_CONFIG))
    env = os.environ.copy()
    env['PATH'] = config_dir + ':' + env.get('PATH', '')
    if extra_env: env.update(extra_env)

    self.log(f'Running {name}: {hook}')
    child = os.fork()
    if child == 0:
      os.execvpe('bash', ['bash', '-c', hook], env)
    _, status = os.waitpid(child, 0)
    return os.waitstatus_to_exitcode(status)


  def apply_rule(self, rule, origin = None):
    if isinstance(rule, list):
      for r in rule: self.apply_rule(r, origin)
      return

    # Rule names can contain variable references
    rules = self.expand(rule)

    # Private rules are found in the config of the rule using them
    key = (origin or self.origin, rule) if rule.startswith('_') else rule
    if key not in self.rules: raise SBError(f'Unknown rule "{rule}"')

    # Only apply each rule once
    if key in self.applied: return
    self.applied.append(key)

    self.log(f'Applying rule {rule}')
    prev, (self.origin, actions) = self.origin, self.rules[key]
    self.apply_actions(actions)
    self.origin = prev


  def apply_actions(self, actions):
    for action in actions:
      if isinstance(action, dict):
        self.apply_action(action)


  def apply_action(self, action):
    for name, params in action.items():
      method = getattr(self, 'action_' + name.replace('-', '_'), None)

      if method is None:
        raise SBError(f'Unknown action "{name}"')
        sys.exit(1)

      method(params)


  def add_perms(self, params):
    if isinstance(params, dict) and 'perms' in params:
      self.cmd_args.extend(('--perms', f'0{int(params['perms'], 0):o}'))


  def action_use(self, params): self.apply_rule(params)


  def action_args(self, params):
    self.cmd_args.extend((self.expand(a) for a in params))


  def action_die_with_parent(self, params):
    if not isinstance(params, bool):
      raise SBError('"die-with-parent" requires bool')

    self.die_with_parent = params


  def action_env(self, params):
    if isinstance(params, str): params = [params]

    if isinstance(params, dict):
      for k, v in params.items():
        self.cmd_args.extend(('--setenv', k, self.expand(v)))

    elif isinstance(params, list):
      for k in params:
        if k in os.environ:
          self.cmd_args.extend(('--setenv', k, os.environ[k]))


  def create_skel(self, path):
    copytree('/etc/skel', path)
    with open(path + '/.bashrc', 'a') as f:
      f.write(f'\nPS1="({self.args.name}) $PS1"\n')


  def action_skel(self, params):
    if isinstance(params, str): params = {'path': params}
    self.create_skel(self.expand(params['path']))


  def action_tmp_overlay(self, params):
    if isinstance(params, str): params = {'path': params}

    path = self.expand(params['path'])

    if params.get('skel', False):
      tempdir = tempfile.mkdtemp()
      self.tempdirs.add(tempdir)
      shutil.copytree('/etc/skel', tempdir, dirs_exist_ok = True)
      self.cmd_args.extend(('--overlay-src', tempdir))

    self.cmd_args.extend((f'--tmp-overlay', path))


  def action_bind(self, params):
    if isinstance(params, str): params = {'path': params}

    src = os.getcwd() if params.get('cwd', False) else params['path']
    dst = params.get('dst', src)
    src = self.expand(src)
    dst = self.expand(dst)

    create = params.get('create', False)
    if create and not os.path.exists(src):
      os.makedirs(src)
      if create == 'skel': self.create_skel(src)

    if params.get('dev', False): type = 'dev-bind'
    else: type = 'bind' if params.get('read-write', False) else 'ro-bind'
    if params.get('try', False): type += '-try'

    self.add_perms(params)
    self.cmd_args.extend((f'--{type}', src, dst))


  def action_hide(self, params):
    if isinstance(params, str): params = [params]

    for path in params:
      expanded = self.expand_path(path)
      if not os.path.exists(expanded):
        self.log(f'hide: skipping missing path "{expanded}"')
        continue

      if os.path.isdir(expanded):
        self.cmd_args.extend(('--tmpfs', expanded))
      else:
        self.cmd_args.extend(('--ro-bind', '/dev/null', expanded))


  def action_portal(self, params):
    if isinstance(params, str): params = [params]
    self.portals.update(params)


  def action_dbus_forward(self, params):
    if isinstance(params, str): params = [params]
    self.dbus_forwards.update(self.expand(name) for name in params)


  def set_level(self, name, levels, value):
    if value not in levels:
      raise SBError(f'"{name}" requires one of: {", ".join(levels)}')

    # The most permissive level wins
    current = getattr(self, name)
    if current is None or levels.index(value) < levels.index(current):
      setattr(self, name, value)


  def action_x11(self, params): self.set_level('x11', X11_LEVELS, params)
  def action_net(self, params): self.set_level('net', NET_MODES, params)


  def action_allow_net(self, params):
    if isinstance(params, str): params = [params]
    try:
      self.allow_net.update(parse_allow_net(self.expand(net)) for net in params)
    except ValueError as e: raise SBError(f'"allow-net": {e}')


  def action_host_port(self, params):
    if not isinstance(params, list): params = [params]
    self.host_ports.update(int(port) for port in params)


  def action_proxy(self, params):
    if params is True:
      names = [var for name in PROXY_VARS + ('all_proxy', 'no_proxy')
               for var in (name, name.upper()) if os.environ.get(var)]
      self.action_env(names)
      self.proxies.update(
        os.environ[var] for var in names if var.lower() != 'no_proxy')

    elif isinstance(params, str):
      self.action_env(
        {var: params for name in PROXY_VARS for var in (name, name.upper())})
      self.proxies.add(self.expand(params))

    else: raise SBError('"proxy" requires a URL or true')


  def action_file(self, params):
    if isinstance(params, str): params = dict(path = params)

    fd = fork_and_write(params.get('data', ''))
    self.add_perms(params)
    self.cmd_args.extend(('--file', f'{fd}', self.expand(params['path'])))


  def action_dir(self, params):
    if isinstance(params, str): params = {'path': params}

    self.add_perms(params)
    self.cmd_args.extend(('--dir', self.expand_path(params['path'])))


  def action_symlink(self, params):
    if isinstance(params, str): params = [params, params]
    self.add_perms(params)
    self.cmd_args.extend((
      '--symlink', self.expand(params[0]), self.expand(params[1])))


  def action_chdir(self, params):
    if not isinstance(params, str):
      raise SBError('"chdir" requires string parameter')
    self.cmd_args.extend(('--chdir', self.expand(params)))


  def action_allow_syscalls(self, params):
    if isinstance(params, str): params = [params]

    for group in params:
      if group not in SECCOMP_GROUPS:
        raise SBError(f'Unknown syscall group "{group}"')
      self.allowed_syscalls.add(group)


  def action_ifeq(self, params, ifneq = False):
    if not isinstance(params, list) or len(params) < 2:
      raise SBError(
        f'"if{'n' if ifneq else ''}eq" requires a list with at least 2 ' +
        'elements')

    if (self.expand(params[0]) == self.expand(params[1])) != ifneq:
      self.apply_actions(params[2:])


  def action_ifneq(self, params): self.action_ifeq(params, True)


  def action_ifdef(self, params):
    if not isinstance(params, list) or len(params) < 1:
      raise SBError('"ifdef" requires a non-empty list')

    if params[0] in os.environ: self.apply_actions(params[1:])


  def fs_arg(self, params, name):
    if isinstance(params, str): path = params
    elif isinstance(params, dict):
      path = params.get('path')
      self.add_perms(params)
    else: raise SBError(f'"{name}" requires string or dict parameter')

    self.cmd_args.extend((f'--{name}', self.expand_path(path)))


  def action_dev(self,  params):  self.fs_arg(params, 'dev')
  def action_proc(self, params):  self.fs_arg(params, 'proc')


  def action_tmpfs(self, params):
    if isinstance(params, dict) and 'size' in params:
      self.cmd_args.extend(('--size', self.expand(params['size'])))

    self.fs_arg(params, 'tmpfs')


  def setup_seccomp(self):
    f = seccomp.SyscallFilter(defaction = seccomp.ALLOW)
    allowed = self.allowed_syscalls

    def block(err, syscall, *args):
      f.add_rule(seccomp.ERRNO(err), syscall, *args)

    # --new-session breaks interactive sessions, this is an alternative way of
    # fixing CVE-2017-5226
    for req in (termios.TIOCSTI, termios.TIOCLINUX):
      f.add_rule(seccomp.KILL_PROCESS, 'ioctl',
                 seccomp.Arg(1, seccomp.MASKED_EQ, 0xffffffff, req))

    if 'sockets' not in allowed:
      allow = (socket.AF_UNSPEC, socket.AF_UNIX, socket.AF_INET,
               socket.AF_INET6, socket.AF_NETLINK)
      deny  = [seccomp.Arg(0, seccomp.EQ, family)
               for family in range(max(allow)) if family not in allow]
      deny.append(seccomp.Arg(0, seccomp.GT, max(allow)))
      for arg in deny: block(errno.EAFNOSUPPORT, 'socket', arg)

    if 'io-uring' not in allowed:
      for call in ('io_uring_setup', 'io_uring_enter', 'io_uring_register'):
        block(errno.ENOSYS, call)

    if 'keyring' not in allowed:
      for call in ('keyctl', 'add_key', 'request_key'):
        block(errno.ENOSYS, call)

    if 'userns' not in allowed:
      for call in ('unshare', 'clone'):
        block(errno.EPERM, call, seccomp.Arg(
          0, seccomp.MASKED_EQ, os.CLONE_NEWUSER, os.CLONE_NEWUSER))
      block(errno.ENOSYS, 'clone3') # Flags not filterable, force clone()

    fd = os.memfd_create('sbx-seccomp', 0)
    with open(fd, 'wb', closefd = False) as file: f.export_bpf(file)
    os.lseek(fd, 0, os.SEEK_SET)
    self.seccomp_bpf = os.pread(fd, os.fstat(fd).st_size, 0) # For sbx enter
    self.cmd_args.extend(('--seccomp', f'{fd}'))


  def setup_x11(self):
    if not self.x11: return

    display = os.environ.get('DISPLAY')
    if not display: raise SBError('"x11" requires DISPLAY')

    # Host based access, e.g. "SI:localuser", bypasses the cookie and, with the
    # host's network, the proxy
    if self.x11 == 'untrusted' or self.net == 'host':
      try: lines = subprocess.run(
          ['xhost'], capture_output = True, text = True).stdout.splitlines()
      except OSError: lines = []

      if lines and ('disabled' in lines[0] or 1 < len(lines)):
        print('WARNING: X server grants access without a cookie, X11 '
              'isolation is not enforced.  See "xhost".', file = sys.stderr)

    if self.x11 == 'filtered': return self.setup_x11_proxy(display)

    host, _, num = display.partition(':')
    if host in ('', 'unix'):
      sock = f'/tmp/.X11-unix/X{num.split('.')[0]}'
      self.cmd_args.extend(('--ro-bind-try', sock, sock))

    # Generate a new cookie rather than exposing the host's
    with tempfile.TemporaryDirectory(dir = self.runtime_dir) as dir:
      path = f'{dir}/Xauthority'
      open(path, 'wb').close() # Avoid xauth "does not exist" message
      try:
        out = subprocess.run(['xauth', '-v', '-f', path, 'generate', display,
                              '.', self.x11, 'timeout', '0'], check = True,
                             stdout = subprocess.PIPE, text = True).stdout
      except (OSError, subprocess.CalledProcessError) as e:
        raise SBError(f'Failed to generate X11 cookie: {e}')

      with open(path, 'rb') as f: cookie = f.read()

    # Save ID so the cookie can be revoked on exit
    for line in out.splitlines():
      if line.startswith('authorization id is '):
        self.x11_auth_id = int(line.split()[-1])

    # Wildcard address family so the cookie matches any hostname
    cookie = b'\xff\xff' + cookie[2:]

    path = f'{self.runtime_dir}/Xauthority'
    self.cmd_args.extend((
      '--ro-bind-data', f'{fork_and_write(cookie)}', path,
      '--setenv', 'XAUTHORITY', path, '--setenv', 'DISPLAY', display))


  def setup_x11_proxy(self, display):
    # A display number unused on the host, so clients reach the proxy rather
    # than the X server's abstract socket
    num  = next(n for n in range(64, 256) if not display_in_use(n))
    dir  = f'{self.runtime_dir}/sbx/{self.args.name}'
    sock = f'{dir}/X11-{os.getpid()}'
    os.makedirs(dir, mode = 0o700, exist_ok = True)

    self.start_helper('sbx-x11', [display, sock, f'--exit-fd={self.sync_r}'],
                      f'{dir}/x11.log', [self.sync_r])
    self.cmd_args.extend(('--bind', sock, f'/tmp/.X11-unix/X{num}',
                          '--setenv', 'DISPLAY', f':{num}'))


  def watch_sandbox(self):
    # bwrap holds --sync-fd open until every process in the sandbox has
    # exited, even if they close it, which may be after sbx.  Then revoke the
    # X11 cookie, release the portal lock and remove sbx enter's state.  The X11
    # proxy also watches it.
    os.set_inheritable(self.sync_w, True)
    self.cmd_args.extend(('--sync-fd', f'{self.sync_w}'))

    sys.stdout.flush()
    sys.stderr.flush()

    if os.fork() == 0: # Inherits the portal lock
      os.setsid()
      os.close(self.sync_w)
      os.read(self.sync_r, 1) # EOF
      self.revoke_x11()
      shutil.rmtree(self.state, ignore_errors = True)
      os._exit(0)


  def save_state(self):
    '''The sandbox's environment and seccomp filter, for sbx enter.'''
    env, args = dict(os.environ), iter(self.cmd_args)
    for arg in args:
      if arg == '--clearenv': env.clear()
      elif arg == '--setenv': env.update([(next(args), next(args))])
      elif arg == '--unsetenv': env.pop(next(args), None)

    os.makedirs(self.state, mode = 0o700, exist_ok = True)
    with open(f'{self.state}/env.json', 'w') as f: json.dump(env, f)
    with open(f'{self.state}/seccomp.bpf', 'wb') as f: f.write(self.seccomp_bpf)


  def revoke_x11(self):
    if self.x11_auth_id is None: return

    x11  = ctypes.CDLL('libX11.so.6')
    xext = ctypes.CDLL('libXext.so.6')
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    xext.XSecurityRevokeAuthorization.argtypes = [
      ctypes.c_void_p, ctypes.c_ulong]

    # Xlib's default error handler exits the process
    errors  = []
    handler = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)(
      lambda dpy, event: errors.append(event) or 0)
    x11.XSetErrorHandler(handler)

    dpy = x11.XOpenDisplay(None)
    if dpy:
      xext.XSecurityRevokeAuthorization(dpy, self.x11_auth_id)
      x11.XSync(dpy, 0) # Errors are asynchronous
      x11.XCloseDisplay(dpy)

    if not dpy or errors:
      print('WARNING: Failed to revoke X11 cookie', file = sys.stderr)


  def setup_net(self):
    self.net = self.net or 'isolated'
    if self.net == 'host': return
    self.cmd_args.append('--unshare-net')
    if self.net == 'none': return
    self.allow_proxies()

    # bwrap waits on --block-fd until start_net() has configured the network
    self.net_info, info_w   = os.pipe()
    block_r, self.net_block = os.pipe()
    self.net_fds = (info_w, block_r)
    for fd in self.net_fds: os.set_inheritable(fd, True)
    self.cmd_args.extend(('--info-fd', f'{info_w}', '--block-fd', f'{block_r}'))

    # DNS via pasta, the host's resolver may be on a blocked network
    try:
      with open('/etc/resolv.conf') as f:
        conf = ''.join(line for line in f if not line.startswith('nameserver'))
    except OSError: conf = ''
    conf += f'nameserver {DNS_FORWARD}\n'
    self.cmd_args.extend(
      ('--ro-bind-data', f'{fork_and_write(conf)}', '/etc/resolv.conf'))


  def allow_proxies(self):
    for value in self.proxies:
      try:
        url = urllib.parse.urlsplit(
          value if '://' in value else f'http://{value}')
        if not url.hostname or not url.port: raise ValueError('no port')
        addrs = socket.getaddrinfo(url.hostname, url.port,
                                   type = socket.SOCK_STREAM)
      except (ValueError, OSError) as e:
        print(f'WARNING: Not allowing proxy "{value}": {e}', file = sys.stderr)
        continue

      for *_, (addr, *_) in addrs:
        addr = ipaddress.ip_address(addr)
        # Only pasta's forwards reach the host's loopback
        if addr.is_loopback: self.host_ports.add(url.port)
        else: self.allow_net.add((ipaddress.ip_network(addr), url.port))


  def net_rules(self):
    # Policy rules take precedence over routes, which pasta copies from the host
    out = subprocess.run(['ip', '-j', 'addr', 'show', 'scope', 'global'],
                         capture_output = True, text = True,
                         check = True).stdout
    host = tuple(a['local'] for i in json.loads(out) for a in i['addr_info']
                 if 'local' in a) # Excluded addresses are empty

    rules = {4: '', 6: ''}
    def add(pref, action, net, port = None):
      net   = ipaddress.ip_network(net)
      match = f' ipproto tcp dport {port}' if port else ''
      rules[net.version] += f'rule add to {net}{match} pref {pref} {action}\n'

    # The host first, allow-net cannot unblock it
    for net in host: add(50, 'prohibit', net)
    for net, port in self.allow_net: add(100, 'lookup main', net, port)
    for net in BLOCKED_NETS: add(200, 'prohibit', net)

    return rules


  def start_net(self):
    for fd in self.net_fds: os.close(fd)
    with open(self.net_info) as f: info = f.read()
    if not info: return # bwrap failed and reports why
    pid   = str(json.loads(info)['child-pid'])
    ports = ','.join(map(str, sorted(self.host_ports))) or 'none'

    try:
      # The sandbox runs in a user namespace nested in the network's owner
      with open(f'/proc/{pid}/ns/net') as net:
        owner = fcntl.ioctl(net, NS_GET_USERNS)
      userns = f'/proc/{os.getpid()}/fd/{owner}'

      subprocess.run(
        ['pasta', '--config-net', '--quiet', '--userns', userns,
         '--map-host-loopback', 'none', '--map-guest-addr', 'none',
         '--dns-forward', DNS_FORWARD, '-t', 'none', '-u', 'none', '-T', ports,
         '-U', 'none', pid], check = True)

      for version, rules in self.net_rules().items():
        subprocess.run(
          ['nsenter', f'--user={userns}', f'--net=/proc/{pid}/ns/net',
           '--preserve-credentials', '--keep-caps', 'ip', f'-{version}',
           '-batch', '-'], input = rules, text = True, check = True)

      os.close(owner)

    except (OSError, subprocess.CalledProcessError) as e:
      os.kill(int(pid), signal.SIGKILL) # Never run partially configured
      raise SBError(f'Failed to set up network: {e}')

    os.write(self.net_block, b'x')
    os.close(self.net_block)


  def start_helper(self, name, args, log, keep = ()):
    '''Start a program from sbx's directory and wait until it is ready.'''
    pr, pw = os.pipe()
    cmd = [os.path.dirname(os.path.realpath(__file__)) + '/' + name] + args + \
      [f'--ready-fd={pw}'] + (['--verbose'] if self.args.verbose else [])

    if os.fork() == 0:
      try:
        # Detach from the terminal and drop other inherited fds, e.g. locks
        os.setsid()
        null = os.open('/dev/null', os.O_RDWR)
        out  = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.dup2(null, 0)
        os.dup2(out, 1)
        os.dup2(out, 2)

        keep = {pw, *keep}
        for fd in map(int, os.listdir('/proc/self/fd')):
          if 2 < fd and fd not in keep:
            try: os.close(fd)
            except OSError: pass
        for fd in keep: os.set_inheritable(fd, True)

        os.execv(cmd[0], cmd)

      except OSError as e: print(f'Failed to run {cmd[0]}: {e}', flush = True)
      finally: os._exit(1)

    os.close(pw)
    ready = os.read(pr, 1) == b'x'
    os.close(pr)

    if not ready: raise SBError(f'Failed to start {name}, see "{log}"')


  def setup_portal(self):
    if not (self.portals or self.dbus_forwards): return

    app_id = os.environ['APP_NAME']
    dir    = f'{self.runtime_dir}/sbx/{self.args.name}'
    os.makedirs(dir, mode = 0o700, exist_ok = True)

    # Held for the life of the sandbox, the service exits when none are held.
    # See watch_sandbox().
    self.portal_lock = open(f'{dir}/lock', 'a')
    fcntl.flock(self.portal_lock, fcntl.LOCK_SH)

    # Runs of the same sandbox share one service
    with open(f'{dir}/start', 'a') as start:
      fcntl.flock(start, fcntl.LOCK_EX)
      with socket.socket(socket.AF_UNIX) as s:
        try: s.connect(f'{dir}/bus')
        except OSError:
          self.start_helper(
            'sbx-portal', [dir, app_id] +
            [f'--portal={p}' for p in self.portals] +
            [f'--forward={name}' for name in self.dbus_forwards],
            f'{dir}/portal.log')

    bus = f'{self.runtime_dir}/bus'
    self.cmd_args.extend((
      '--bind', f'{dir}/bus', bus,
      '--setenv', 'DBUS_SESSION_BUS_ADDRESS', f'unix:path={bus}'))

    if 'file-chooser' in self.portals:
      self.cmd_args.extend((
        '--bind-try', f'{self.runtime_dir}/doc/by-app/{app_id}',
        f'{self.runtime_dir}/doc'))


  def run(self):
    # Load config
    self.require_config()
    local_path, local_use = self.load_local()
    self.load_config(SANDBOX_CONFIG)

    # Pre-run hook
    rc = self.run_hook('pre-hook')
    if rc != 0: sys.exit(rc)

    # Command
    if self.args.command: command = [self.args.command]
    else:
      if not 'command' in self.config:
        raise SBError('Sandbox config is missing "command"')
      command = self.config['command']
    command += self.args.args

    exp_command = [self.expand(arg) for arg in command]
    os.environ['SANDBOX_CMD'] = shlex.join(exp_command)
    os.environ['SANDBOX_EXE'] = exp_command[0]

    # Found by sbx ps and sbx enter in bwrap's environment
    os.environ['SBX_ROOT_PID'] = str(os.getpid())
    self.state = f'{self.runtime_dir}/sbx/{self.args.name}/{os.getpid()}'

    # Apply rules
    self.apply_rule(self.config.get('use', []), self.config_path)
    self.apply_rule(local_use, local_path)
    self.setup_seccomp()
    self.sync_r, self.sync_w = os.pipe() # See watch_sandbox()
    self.setup_portal()
    self.setup_x11() # Last, so errors above don't leave a cookie unrevoked
    self.watch_sandbox()
    self.setup_net() # After watch_sandbox()'s fork, which would hold the pipes

    # Die with parent
    if self.die_with_parent: self.cmd_args.append('--die-with-parent')

    # Build command (wrap in login shell so ~/.profile is sourced)
    cmd = ['bwrap'] + self.cmd_args + ['bash', '-lc', shlex.join(exp_command)]
    self.log('@' + shlex.join(cmd))

    # Execute
    self.save_state()
    child = os.fork()
    if child == 0: os.execvp(cmd[0], cmd)
    if self.net == 'isolated': self.start_net()
    _, status = os.waitpid(child, 0)
    exit_code = os.waitstatus_to_exitcode(status)

    # Cleanup temp dirs
    for path in self.tempdirs:
      shutil.rmtree(path)

    # Post-run hook
    rc = self.run_hook('post-hook', {'SANDBOX_EXIT_CODE': str(exit_code)})
    sys.exit(rc if rc != 0 else exit_code)


  def create(self):
    # Check sandbox config
    sandbox_config = self.expand_path(SANDBOX_CONFIG)
    if os.path.exists(sandbox_config):
      raise SBError(f'Sandbox "{self.args.name}" already exists')

    # Template and --config are mutually exclusive
    if self.args.template and self.args.config:
      raise SBError('--template and --config are mutually exclusive')

    # --template forbids --rule and command overrides (copied verbatim)
    if self.args.template and (self.args.rule or self.args.command):
      raise SBError('--template cannot be combined with --rule or command')

    if self.args.template: template_dir = self.find_template(self.args.template)
    config_dir = os.path.dirname(sandbox_config)
    os.makedirs(config_dir, exist_ok = True)

    if self.args.template:
      # Copy template contents verbatim (config.yml, hook scripts, etc.)
      # Skip 'home/' which is seeded separately into SANDBOX_HOME.
      for entry in os.listdir(template_dir):
        if entry == 'home': continue
        src = os.path.join(template_dir, entry)
        dst = os.path.join(config_dir, entry)
        if os.path.isdir(src): shutil.copytree(src, dst, symlinks = True)
        else: shutil.copy2(src, dst)

      # Seed home from template
      template_home = f'{template_dir}/home'
      if os.path.isdir(template_home):
        sandbox_home = self.expand_path(SANDBOX_HOME)
        if os.path.exists(sandbox_home):
          raise SBError(
            f'Sandbox home "{sandbox_home}" already exists; refusing to ' +
            'seed from template')
        shutil.copytree(template_home, sandbox_home, symlinks = True)

      # Load the newly-installed config so hooks can fire
      self.load_config(SANDBOX_CONFIG)

    else:
      # --config or default: synthesize config_data, inline or import rules
      config = self.args.config if self.args.config else self.default_config()
      self.load_config(config)

      command =self.args.command or self.config.get('command', ['bash'])
      rules   = self.args.rule    or self.config.get('use', [])
      config_data = dict(use = rules, command = command)

      if self.args.config:
        # Private rules of all configs end up in one
        config_data['rules'] = {}
        for key, (_, rule) in self.rules.items():
          name = key if isinstance(key, str) else key[1]
          if name in config_data['rules']:
            raise SBError(f'Private rule "{name}" is in several configs')
          config_data['rules'][name] = rule

      else: config_data['imports'] = [config]

      with open(sandbox_config, 'w') as f:
        yaml.dump(
          config_data, f, Dumper = Dumper, width = 80, sort_keys = False,
          default_flow_style = False)

    rc = self.run_hook('create-hook')
    if rc != 0: sys.exit(rc)


  def list(self):
    root = self.expand_path(SANDBOX_ROOT)
    names = []

    for name in os.listdir(root):
      path = f'{root}/{name}'
      if os.path.isdir(path) and os.path.exists(f'{path}/config.yml'):
        names.append(name)

    for name in sorted(names): print(name)


  def list_rules(self):
    # Load default config
    config = self.args.config if self.args.config else self.default_config()
    self.load_local()
    self.load_config(config)

    rules = {k: r for k, (_, r) in self.rules.items() if isinstance(k, str)}
    width = reduce(lambda x, name: max(len(name), x), rules, 0)

    for rule in sorted(rules):
      help = ''

      first = rules[rule][:1]
      if len(first) and isinstance(first[0], str): help = first[0]

      use = []
      for action in rules[rule]:
        if isinstance(action, dict):
          for name, params in action.items():
            if name == 'use':
              if isinstance(params, str): use.append(params)
              else: use += params

      if len(use):
        if help: help = help + ' '
        help += f'(Uses: {' '.join(use)})'

      if help: print(f'{rule:<{width}} - {help}')
      else: print(rule)


  def running(self):
    '''Running sandboxes, as (name, PID of their init process).'''
    # Dictionary to group processes by their PID namespace inode
    ns_groups = defaultdict(list)
    our_ns_inode = get_pid_ns()

    # Iterate through all entries in /proc
    for pid_dir in os.listdir('/proc'):
      if not pid_dir.isdigit(): continue

      pid = int(pid_dir)
      path = f'/proc/{pid}'

      try:
        # Check if the process name is 'bwrap'
        with open(f'{path}/comm', 'r', errors='ignore') as f:
          if f.read().strip() != 'bwrap': continue

        # Filter by the environment variable SBX_ROOT_PID
        name  = None
        valid = False
        with open(f'{path}/environ', 'r', errors = 'ignore') as f:
          env = f.read().split('\0')
          for var in env:
            if   var.startswith('SANDBOX='):      name  = var[8:]
            elif var.startswith('SBX_ROOT_PID='): valid = True

        if not valid: continue

        # Get the PID namespace identifier
        ns_inode = get_pid_ns(pid)
        if ns_inode == our_ns_inode: continue

        # Get the process start time to determine age
        with open(f'{path}/stat', 'r', errors='ignore') as f:
          stat_fields = f.read().split()
          # Use field 21 (0-indexed) which corresponds to the 22nd field
          start_time = int(stat_fields[21])

        # Group the verified process
        ns_groups[ns_inode].append((pid, start_time, name))

      except (FileNotFoundError, ProcessLookupError, PermissionError,
              IndexError, ValueError): continue

    # Extract the oldest PID from each shared PID namespace group
    entries = []
    for ns_inode, procs in ns_groups.items():
      procs.sort(key = lambda x: x[1])
      entries.append((procs[0][2], procs[0][0]))

    return sorted(entries)


  def ps(self):
    entries = self.running()
    width   = max((len(str(p)) for _, p in entries), default = 4)
    print(f'{"PID":<{width}} SANDBOX')
    for name, pid in entries: print(f'{pid:<{width}} {name}')


  def delete(self):
    config = self.require_config()
    self.load_config(SANDBOX_CONFIG)

    # Delete hook (fires before any rmtree)
    rc = self.run_hook('delete-hook')
    if rc != 0: sys.exit(rc)

    paths = [os.path.dirname(config)]
    home = self.expand_path(SANDBOX_HOME)
    if os.path.isdir(home): paths.append(home)

    for path in paths: self.log(f'Preparing to delete "{path}"')

    if not self.args.force:
      response = input(f'Delete sandbox "{self.args.name}"? [Yes/No] ')
      if not response.lower() in ('yes', 'y'): return

    for path in paths: shutil.rmtree(path)


  def update(self):
    self.require_config()
    self.load_config(SANDBOX_CONFIG)
    if not self.config.get('update-hook'):
      raise SBError(f'Sandbox "{self.args.name}" has no "update-hook"')
    sys.exit(self.run_hook('update-hook'))


  def rename(self):
    old, new = self.args.name, self.args.new_name
    if not new or '/' in new or new.startswith('.'):
      raise SBError(f'Invalid sandbox name "{new}"')
    self.require_config()
    if any(name == old for name, _ in self.running()):
      raise SBError(f'Sandbox "{old}" is running')

    moves = []
    for path in (os.path.dirname(SANDBOX_CONFIG), SANDBOX_HOME):
      src, dst = (self.expand_path(path.replace('$SANDBOX', name))
                  for name in (old, new))
      if os.path.exists(dst): raise SBError(f'"{dst}" already exists')
      if os.path.exists(src): moves.append((src, dst))

    for src, dst in moves:
      self.log(f'Moving "{src}" to "{dst}"')
      os.rename(src, dst)


  def default_config(self):
    '''The user's global.yml, or the one installed with sbx.'''
    if os.path.exists(self.expand_path(DEFAULT_CONFIG)): return DEFAULT_CONFIG
    return '$SBX_LIB/global.yml'


  def find_template(self, name):
    '''User templates first, so they can replace those installed with sbx.'''
    roots = (self.expand_path(SANDBOX_TEMPLATES), f'{SBX_LIB}/templates')
    for root in roots:
      if os.path.isfile(f'{root}/{name}/config.yml'): return f'{root}/{name}'

    names = sorted({n for root in roots if os.path.isdir(root)
                    for n in os.listdir(root)
                    if os.path.isfile(f'{root}/{n}/config.yml')})
    raise SBError(f'Template "{name}" not found, available: ' +
                  (', '.join(names) or 'none'))


  def show(self):
    with open(self.require_config(), 'r') as f:
      sys.stdout.write(f.read())


  def template(self):
    config = self.require_config()
    target = self.expand_path(
      f'{SANDBOX_TEMPLATES}/{self.args.template_name}')

    if os.path.exists(target):
      if not self.args.force:
        raise SBError(
          f'Template "{self.args.template_name}" already exists; use ' +
          '--force to overwrite')
      shutil.rmtree(target)

    os.makedirs(target)

    # Copy entire sandbox config dir (config.yml + any hook scripts)
    config_dir = os.path.dirname(config)
    for entry in os.listdir(config_dir):
      src = os.path.join(config_dir, entry)
      dst = os.path.join(target, entry)
      if os.path.isdir(src): shutil.copytree(src, dst, symlinks = True)
      else: shutil.copy2(src, dst)

    home = self.expand_path(SANDBOX_HOME)
    if os.path.isdir(home):
      shutil.copytree(home, f'{target}/home', symlinks = True)


  def edit(self):
    if not 'EDITOR' in os.environ: editor = 'vi'
    else: editor = os.environ['EDITOR']

    if not shutil.which(editor):
      raise SBError('"EDITOR" environment variable set to invalid command')

    cmd = [editor, self.require_config()]
    os.execvp(cmd[0], cmd)


  def enter(self):
    '''Start a login shell in a running sandbox, restricted like the sandbox's
    processes.  As the owner of its user namespace, no privileges are needed.'''
    target  = self.args.target
    running = [(n, p) for n, p in self.running()
               if target in (n, str(p))]
    if not running: raise SBError(f'No running sandbox "{target}"')
    if 1 < len(running):
      raise SBError(f'Several instances of "{target}" are running, give a PID '
                    'from "sbx ps"')
    name, init = running[0]

    with open(f'/proc/{init}/environ') as f:
      env = dict(v.split('=', 1) for v in f.read().split('\0') if '=' in v)
    state = f'{self.runtime_dir}/sbx/{name}/{env['SBX_ROOT_PID']}'
    try:
      with open(f'{state}/env.json') as f: env = json.load(f)
      with open(f'{state}/seccomp.bpf', 'rb') as f: bpf = f.read()
    except OSError as e: raise SBError(f'Cannot enter "{name}": {e}')

    # The sandbox command's working directory, or the root
    with open(f'/proc/{init}/task/{init}/children') as f: children = f.read()
    cwd = os.open(f'/proc/{children.split()[0]}/cwd' if children else
                  f'/proc/{init}/root', os.O_RDONLY | os.O_DIRECTORY)

    # Open all before joining any, the mount namespace changes /proc
    ns = {kind: os.open(f'/proc/{init}/ns/{kind}', os.O_RDONLY)
          for kind in ('user', 'ipc', 'uts', 'net', 'pid', 'mnt')}
    owner = fcntl.ioctl(ns['mnt'], NS_GET_USERNS) # bwrap may nest 'user' in it

    # Skip namespaces already joined, e.g. the host's network
    ino  = lambda fd: os.fstat(fd).st_ino
    join = [(ns[kind], flag) for kind, flag in (
      ('ipc', os.CLONE_NEWIPC), ('uts', os.CLONE_NEWUTS),
      ('net', os.CLONE_NEWNET), ('pid', os.CLONE_NEWPID),
      ('mnt', os.CLONE_NEWNS))
            if ino(ns[kind]) != os.stat(f'/proc/self/ns/{kind}').st_ino]
    if ino(ns['user']) != ino(owner): join.append((ns['user'],
                                                   os.CLONE_NEWUSER))

    os.setns(owner, os.CLONE_NEWUSER) # Grants the rights to join the others
    for fd, flag in join: os.setns(fd, flag)

    child = os.fork() # Joins the PID namespace
    if child == 0:
      try:
        os.fchdir(cwd)
        for cap in range(64): libc.prctl(PR_CAPBSET_DROP, cap, 0, 0, 0)
        prog = SockFprog(len(bpf) // 8, bpf)
        if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) or \
           libc.prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, ctypes.byref(prog),
                      0, 0):
          raise OSError(ctypes.get_errno(), 'Failed to apply seccomp filter')
        # A login shell, or the command run by one as "sbx run" does
        cmd = ['-c', shlex.join(self.args.command)] if self.args.command else []
        os.execve('/bin/bash', ['bash', '-l', *cmd], env)

      except OSError as e: print(f'ERROR: {e}', file = sys.stderr)
      finally: os._exit(1)

    _, status = os.waitpid(child, 0)
    sys.exit(os.waitstatus_to_exitcode(status))


  def exec(self):
    if hasattr(self.args, 'name'):
      os.environ['SANDBOX']        = self.args.name
      os.environ['SANDBOX_HOME']   = self.expand(SANDBOX_HOME)
      os.environ['SANDBOX_CONFIG'] = self.expand(SANDBOX_CONFIG)
      os.environ['APP_NAME']       = f'{APP_BASE}.{self.args.name}'

    os.environ['SANDBOX_ROOT'] = self.expand(SANDBOX_ROOT)
    os.environ['SBX_LIB']      = SBX_LIB
    os.environ['SBX_APPS']     = self.expand_path(SANDBOX_APPS)

    getattr(self, self.args.cmd.replace('-', '_'))()


